generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// COMPANY
// ==========================================

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique

  logoUrl   String?
  bannerUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employees   Employee[]
  payslipLogs PayslipLog[]

  @@index([name])
}

// ==========================================
// EMPLOYEE
// ==========================================

model Employee {
  id             String   @id @unique @default(cuid())

  // Employee Information
  name           String
  employee_id    String?  @unique
  email          String
  designation    String
  email_verified Boolean  @default(false)
  phone_num      String

  date_of_joining DateTime? @db.Date

  // Personal & Identification Details
  passport_no          String?
  date_of_birth        DateTime? @db.Date
  nationality          String?
  visa_no              String?
  frro_reg_no          String?
  tax_residency_status String?
  iw_ssa_status        String?

  // Bank & Tax Details
  bank         String
  bank_acc_num String
  bank_ifsc    String
  pan_num      String
  employer_tan String?

  // Company Reference
  // Optional temporarily for migration of existing employees.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Relations
  payslips PayslipLog[]

  // Email must be unique within a company, not globally.
  @@unique([companyId, email])

  @@index([companyId])
}

// ==========================================
// ADMIN
// ==========================================

model Admin {
  id         String   @id @default(cuid())
  name       String
  password   String
  email      String   @unique
  created_at DateTime @default(now())
}

// ==========================================
// VISA PERSON
// ==========================================

model VisaPerson {
  id           String    @id @default(cuid())
  name         String
  passport_num String
  nationality  String
  entry_date   DateTime  @db.Date
  exit_date    DateTime? @db.Date
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  logs VisaLog[]

  @@index([passport_num])
  @@index([entry_date])
}

// ==========================================
// VISA LOG
// ==========================================

model VisaLog {
  id           String     @id @default(cuid())
  visaPersonId String
  visaPerson   VisaPerson @relation(fields: [visaPersonId], references: [id])
  action       VisaAction
  note         String?
  createdAt    DateTime   @default(now())

  @@index([visaPersonId])
}

enum VisaAction {
  ADDED
  ENTRY
  EXIT
  UPDATED
}

// ==========================================
// PAYSLIP HISTORY
// ==========================================

model PayslipLog {
  id         String      @id @default(cuid())

  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])

  // Company Reference
  // Optional temporarily for migration of existing history.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  month     Int
  year      Int
  status    EmailStatus @default(PENDING)
  messageId String?
  createdAt DateTime    @default(now())

  @@index([employeeId])
  @@index([companyId])
  @@index([companyId, year, month])
}

// ==========================================
// ENUMS
// ==========================================

enum EmailStatus {
  PENDING
  SENT
  FAILED
}