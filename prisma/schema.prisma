generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  registeredAddress String?
  employerTan       String?
  bannerUrl         String?
  currency          String  @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employees   Employee[]
  payrolls    Payroll[]
  payslipLogs PayslipLog[]

  @@index([name])
}

model Employee {
  id          String  @id @default(cuid())
  name        String
  employee_id String?
  email       String
  designation String
  phone_num   String

  date_of_birth DateTime? @db.Date
  nationality   String?
  address       String?

  passport_no          String?
  visa_no              String?
  frro_reg_no          String?
  tax_residency_status String?
  iw_ssa_status        String?

  pan_num      String?
  bank_acc_num String?
  bank         String?
  bank_ifsc    String?

  customPayroll Boolean @default(false)
  payrollId     String

  payroll Payroll @relation("EmployeeAssignedPayroll", fields: [payrollId], references: [id], onDelete: Restrict)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  payslips PayslipLog[]

  @@unique([companyId, employee_id])
  @@index([companyId, email])
  @@index([companyId, payrollId])
  @@index([passport_no])
}

model Payroll {
  id   String @id @default(cuid())
  name String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isDefault Boolean @default(false)

  components PayrollComponent[]
  employees  Employee[]         @relation("EmployeeAssignedPayroll")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
  @@index([companyId, isDefault])
}

model PayrollComponent {
  id String @id @default(cuid())

  payrollId String
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  code      String
  name      String
  type      PayrollComponentType
  mode      PayrollCalculationMode
  value     Decimal                @db.Decimal(14, 4)
  isEnabled Boolean                @default(true)
  sortOrder Int                    @default(0)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([payrollId, code])
  @@index([payrollId, type])
  @@index([payrollId, isEnabled])
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  passwordHash String
  email        String   @unique
  created_at   DateTime @default(now())
}

model VisaPerson {
  id         String    @id @default(cuid())
  name       String
  entry_date DateTime  @db.Date
  exit_date  DateTime? @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  logs VisaLog[]
}

model VisaLog {
  id       String     @id @default(cuid())
  personId String
  person   VisaPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  action     VisaAction
  entry_date DateTime?  @db.Date
  exit_date  DateTime?  @db.Date
  notes      String?

  created_at DateTime @default(now())

  @@index([personId])
  @@index([created_at])
}

model PayslipLog {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  month  Int
  year   Int
  payDate DateTime? @db.Date

  workingDays Decimal? @db.Decimal(7, 2)
  offDays     Decimal? @db.Decimal(7, 2)
  leaveDays   Decimal? @db.Decimal(7, 2)
  paidDays    Decimal? @db.Decimal(7, 2)
  lopDays     Decimal? @db.Decimal(7, 2)

  currency        String   @default("INR")
  grossEarnings   Decimal? @db.Decimal(14, 2)
  totalDeductions Decimal? @db.Decimal(14, 2)
  netPay          Decimal? @db.Decimal(14, 2)

  payslipData Json?

  templateVersion String?

  recipientEmail String?
  status         EmailStatus @default(PENDING)
  messageId      String?
  failureReason  String?
  sentAt         DateTime?

  createdAt DateTime @default(now())

  adjustments PayslipAdjustment[]

  @@index([employeeId])
  @@index([employeeId, year, month])
  @@index([companyId])
  @@index([companyId, year, month])
  @@index([status, createdAt])
}

model PayslipAdjustment {
  id String @id @default(cuid())

  payslipLogId String
  payslipLog   PayslipLog @relation(fields: [payslipLogId], references: [id], onDelete: Cascade)

  type        PayslipAdjustmentType
  code        String?
  description String
  amount      Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([payslipLogId])
}

enum PayrollComponentType {
  EARNING
  DEDUCTION
}

enum PayrollCalculationMode {
  FIXED_AMOUNT
  PERCENT_OF_BASIC
}

enum PayslipAdjustmentType {
  EARNING
  DEDUCTION
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum VisaAction {
  ADDED
  ENTRY
  EXIT
  UPDATED
}